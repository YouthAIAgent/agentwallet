{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": "/api/:path*"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
